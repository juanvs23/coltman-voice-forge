# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Runtime data — voices, rendered audio, logs
catalog/*/
!catalog/.gitkeep
out/
*.wav
*.log

# Engine host
engines/.venv/

# Compiled model runtime (built by `voice-forge runtime build`)
dist/

# Local config
.env

# Local tooling state (skill registry cache)
.atl/

# Model weights (downloaded separately, never committed)
models/

# E2E evidence (shared rule 11): committed README, ignored artifacts
tests/**/evidence/
